# TannX OS build
# Kernel: binutils only (as, ld, objcopy). Userspace: gcc -m32 (see USER_CC).
# Images/tests also use: qemu-system-i386/x86_64, mtools, dosfstools, sfdisk,
# OVMF (UEFI), python3 (+PIL for the video clip), curl, nc, tcpdump.

all: agentos32.img

# Scratch directory for the PXE/TFTP helpers (override: make TMPDIR=/path run-pxe)
TMPDIR ?= /tmp
TFTP_DIR = $(TMPDIR)/agentos-tftp

# UEFI firmware for run-uefi (test-uefi.sh has its own lookup). Override with
# make OVMF=/path/to/OVMF.fd run-uefi; the default picks the first one found.
OVMF ?= $(firstword $(wildcard /usr/share/ovmf/OVMF.fd /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF.fd /usr/share/edk2/ovmf/OVMF_CODE.fd))

# --- Remote-control channel (UDP :4713: EXEC/REBOOT/ABORT/STATUS/...) ---
# It is unauthenticated and meant for a headless test PC on a trusted lab
# LAN, so the DEFAULT image leaves it out (the LLM bridge - wish/llm/
# llmscript/netwish - does not need it). `make REMOTE_CTL=1` builds it in;
# agentos32-dev.img is always a REMOTE_CTL build for the remote test suites.
REMOTE_CTL ?= 0
KERNEL_ASFLAGS =
ifeq ($(REMOTE_CTL),1)
KERNEL_ASFLAGS += --defsym REMOTE_CTL=1
endif

# --- boot logo variant: make LOGO=A|B|C (default C) ---
#   A: fir left, wordmark right   B: Agent <fir> Forest, centered
#   C: wordmark over a fir skyline
# The logo data in logo/*.inc is generated by logo/mklogo.py (needs PIL,
# run by hand after editing the design) and committed. logo.cfg records the
# chosen variant so switching LOGO rebuilds the kernel.
LOGO ?= C
ifeq ($(filter A B C,$(LOGO)),)
$(error LOGO must be A, B or C)
endif
KERNEL_ASFLAGS += --defsym LOGO_$(LOGO)=1
# --- boot chime: make CHIME=1 plays a short HDA chime at boot ('run chime').
# Off by default: the headless gate must not depend on a sound device.
ifeq ($(CHIME),1)
KERNEL_ASFLAGS += --defsym BOOT_CHIME=1
endif
LOGO_INC = $(wildcard logo/*.inc)

# --- VBE mode cap (BIOS path): make MAXW=1920 MAXH=1080 (or 1280/800) makes
# stage 2 pick the largest mode within the cap instead of 2560x1600 under
# QEMU -vga std - reproducible desktop-layout screenshots. Default: 4K cap.
MAXW ?= 3840
MAXH ?= 2160
KERNEL_ASFLAGS += --defsym MAXW=$(MAXW) --defsym MAXH=$(MAXH)

logo.cfg: FORCE   # LOGO + mode cap + CHIME: a flag change rebuilds the kernel
	@echo $(LOGO) $(MAXW)x$(MAXH) $(CHIME) | cmp -s - $@ || echo $(LOGO) $(MAXW)x$(MAXH) $(CHIME) > $@

agentos32.o: agentos32.S $(LOGO_INC) logo.cfg
	as $(KERNEL_ASFLAGS) agentos32.S -o agentos32.o

agentos32.elf: agentos32.o linker.ld
	ld -T linker.ld agentos32.o -o agentos32.elf

# --- ring-3 C userspace (ABI v2): the ONE place a compiler is used.
# The kernel stays pure asm; userspace programs are gcc -m32 flat
# binaries at 0x400000 (crt0 + libc + the program), no relocations.
# user.bin is appended to the image at LBA 300; the kernel's 'run'
# command streams it in and starts it in ring 3.
USER_CC = gcc -m32 -ffreestanding -nostdlib -fno-pic -fno-pie \
          -fno-stack-protector -fno-asynchronous-unwind-tables \
          -fcf-protection=none -Os -Wall

USER_SRCS = user/crt0.S user/libc.c user/libc.h user/appmain.c user/video.c \
            user/jpeg.c user/jpeg.h user/net.c user/snake.c user/invaders.c \
            user/hda.c user/gui.c user/vgpu.c user/nvme.c user/xhci.c user/vblk.c \
            user/fetch.c user/fetch_logo.h user/forest.c \
            user/fatfs.c user/fatfs.h user/virtio.c user/virtio.h \
            user/ui.c user/ui.h user/chat.c user/edit.c user/sysmon.c \
            user/audio.c user/audio.h user/aui.c user/aui.h user/rec.c user/synth.c \
            user/voice.c user/chime.c \
            user/dui.c user/dui.h user/tour.c user/www.c user/files.c user/shot.c user/cast.c user/rain.c \
            user/font8x16.h user/font_cp437.h user/sintab.h user/user.ld

user.bin: $(USER_SRCS)
	$(USER_CC) -c user/crt0.S   -o user/crt0.o
	$(USER_CC) -c user/libc.c   -o user/libc.o
	$(USER_CC) -c user/virtio.c -o user/virtio.o
	$(USER_CC) -c user/jpeg.c   -o user/jpeg.o
	$(USER_CC) -c user/video.c  -o user/video.o
	$(USER_CC) -c user/net.c    -o user/net.o
	$(USER_CC) -c user/snake.c  -o user/snake.o
	$(USER_CC) -c user/invaders.c -o user/invaders.o
	$(USER_CC) -c user/hda.c    -o user/hda.o
	$(USER_CC) -c user/gui.c    -o user/gui.o
	$(USER_CC) -c user/fetch.c  -o user/fetch.o
	$(USER_CC) -c user/forest.c -o user/forest.o
	$(USER_CC) -c user/vgpu.c   -o user/vgpu.o
	$(USER_CC) -c user/nvme.c   -o user/nvme.o
	$(USER_CC) -c user/xhci.c   -o user/xhci.o
	$(USER_CC) -c user/vblk.c   -o user/vblk.o
	$(USER_CC) -c user/fatfs.c  -o user/fatfs.o
	$(USER_CC) -c user/ui.c     -o user/ui.o
	$(USER_CC) -c user/chat.c   -o user/chat.o
	$(USER_CC) -c user/edit.c   -o user/edit.o
	$(USER_CC) -c user/sysmon.c -o user/sysmon.o
	$(USER_CC) -c user/audio.c  -o user/audio.o
	$(USER_CC) -c user/aui.c    -o user/aui.o
	$(USER_CC) -c user/rec.c    -o user/rec.o
	$(USER_CC) -c user/synth.c  -o user/synth.o
	$(USER_CC) -c user/voice.c  -o user/voice.o
	$(USER_CC) -c user/chime.c  -o user/chime.o
	$(USER_CC) -c user/appmain.c -o user/appmain.o
	for f in dui tour www files shot cast rain; do $(USER_CC) -c user/$$f.c -o user/$$f.o || exit 1; done   # the TannX apps
	ld -m elf_i386 -T user/user.ld user/crt0.o user/appmain.o user/video.o user/jpeg.o user/net.o user/snake.o user/invaders.o user/hda.o user/gui.o user/fetch.o user/forest.o user/vgpu.o user/nvme.o user/xhci.o user/vblk.o user/fatfs.o user/virtio.o user/ui.o user/chat.o user/edit.o user/sysmon.o user/audio.o user/aui.o user/rec.o user/synth.o user/voice.o user/chime.o user/dui.o user/tour.o user/www.o user/files.o user/shot.o user/cast.o user/rain.o user/libc.o -o user/user.elf
	objcopy -O binary user/user.elf user.bin
	@test $$(stat -c%s user.bin) -le 196608 || (echo "user.bin > 192 KB (USER_BLOB_SECTORS)"; exit 1)

# net.bin: the Ring-3 TCP/IP + HTTP client (crt0 + libc + net.c, no video).
# Not in the default image; test-net-stack.sh flashes it at LBA 300 and runs
# it against QEMU slirp + a host HTTP server.
net.bin: user/crt0.S user/libc.c user/libc.h user/net.c user/user.ld
	$(USER_CC) -c user/crt0.S -o user/crt0.o
	$(USER_CC) -c user/libc.c -o user/libc.o
	$(USER_CC) -c user/net.c  -o user/net.o
	ld -m elf_i386 -T user/user.ld user/crt0.o user/net.o user/libc.o -o user/net.elf
	objcopy -O binary user/net.elf net.bin
	@test $$(stat -c%s net.bin) -le 196608 || (echo "net.bin > 192 KB (USER_BLOB_SECTORS)"; exit 1)

# video.mjpg: a small procedural M-JPEG clip (header + JPEG frames) the
# video program streams from disk at LBA 1024 and decodes with user/jpeg.c.
# Needs PIL to encode the JPEGs (host build tool, not the OS). If PIL is
# missing the clip is left empty and the video program falls back to its
# built-in rectangle demo - the OS still builds and boots.
video.mjpg: user/mkmjpeg.py
	@python3 user/mkmjpeg.py video.mjpg || { \
	  echo "NOTE: PIL unavailable - shipping no video clip (rectangle demo only)"; \
	  : > video.mjpg; }

# Image layout (512-byte sectors): 0-255 kernel, 256 the AGENTOS-MEDIUM
# marker (the kernel only writes to a disk that carries it), 257-264 AgentFS
# slots, 265-272 wish slots, 273 persisted task results, 300-683 the ring-3
# program blob (USER_BLOB_SECTORS = 384 = 192 KB), 1024+ the M-JPEG clip.
agentos32.img: agentos32.elf user.bin video.mjpg
	objcopy -O binary -j .text agentos32.elf agentos32.img
	truncate -s 1474560 agentos32.img
	@printf 'AGENTOS-MEDIUM' | dd of=agentos32.img bs=512 seek=256 conv=notrunc status=none   # medium marker (diskon guard)
	dd if=user.bin of=agentos32.img bs=512 seek=300 conv=notrunc status=none                  # ring-3 userspace blob @ LBA 300
	dd if=video.mjpg of=agentos32.img bs=512 seek=1024 conv=notrunc status=none               # M-JPEG clip @ LBA 1024 (video player)

# agentos32-dev.img: the same image WITH the remote-control channel
# compiled in (see REMOTE_CTL above). Used by test-remote/test-abort and the
# lab tooling (tools/lan/); never the image to hand out.
agentos32-dev.o: agentos32.S $(LOGO_INC) logo.cfg
	as --defsym REMOTE_CTL=1 --defsym LOGO_$(LOGO)=1 --defsym MAXW=$(MAXW) --defsym MAXH=$(MAXH) agentos32.S -o agentos32-dev.o

agentos32-dev.elf: agentos32-dev.o linker.ld
	ld -T linker.ld agentos32-dev.o -o agentos32-dev.elf

agentos32-dev.img: agentos32-dev.elf user.bin video.mjpg
	objcopy -O binary -j .text agentos32-dev.elf agentos32-dev.img
	truncate -s 1474560 agentos32-dev.img
	@printf 'AGENTOS-MEDIUM' | dd of=agentos32-dev.img bs=512 seek=256 conv=notrunc status=none
	dd if=user.bin of=agentos32-dev.img bs=512 seek=300 conv=notrunc status=none
	dd if=video.mjpg of=agentos32-dev.img bs=512 seek=1024 conv=notrunc status=none

dev: agentos32-dev.img

# minimal: the lean core - drops the extras (games) via the MINIMAL
# conditional. Same boot, smaller content footprint = more headroom for
# agent features. Reports the content size (the .org pad keeps the .img
# the same; the win is the budget freed).
minimal:
	as --defsym MINIMAL=1 agentos32.S -o agentos32-min.o
	ld -T linker.ld agentos32-min.o -o agentos32-min.elf
	objcopy -O binary -j .text agentos32-min.elf agentos32-min.img
	truncate -s 1474560 agentos32-min.img
	@printf 'AGENTOS-MEDIUM' | dd of=agentos32-min.img bs=512 seek=256 conv=notrunc status=none
	@echo "--- core/extras content footprint (budget 33280) ---"
	@printf 'full   : %d bytes\n' $$(( 0x$$(nm agentos32.elf     | awk '/ msg_halt$$/{print $$1}') - 31744 ))
	@printf 'minimal: %d bytes\n' $$(( 0x$$(nm agentos32-min.elf | awk '/ msg_halt$$/{print $$1}') - 31744 ))

run: agentos32.img
	qemu-system-i386 -drive format=raw,file=agentos32.img   # boot the 32-bit kernel as a HARD DISK

# run32 boots a LIVE image: fresh kernel (sectors 0-255) on every start,
# but LBA 256+ (medium marker, AgentFS saves, wish slots) survives rebuilds.
# Wishes typed in the running OS land here - 'make wishes' harvests them.
# (The marker stamp also heals older live images that predate the marker
# at LBA 256, without which diskon/wish refuse.)
# live32 only refreshes the live image (the wish loop boots it itself).
live32: agentos32.img
	@test -f agentos32-live.img || cp agentos32.img agentos32-live.img
	@dd if=agentos32.img of=agentos32-live.img bs=512 count=256 conv=notrunc status=none
	@printf 'AGENTOS-MEDIUM' | dd of=agentos32-live.img bs=512 seek=256 conv=notrunc status=none
	@dd if=user.bin of=agentos32-live.img bs=512 seek=300 conv=notrunc status=none      # fresh ring-3 blob too
	@dd if=video.mjpg of=agentos32-live.img bs=512 seek=1024 conv=notrunc status=none   # (slots 257-273 untouched)

run32: live32
	qemu-system-i386 -drive format=raw,file=agentos32-live.img   # 32-bit protected mode

wishes:
	./wishes.sh

# --- Claude Code integration (docs/CLAUDE-CODE.md) ---------------------
# wish-loop: boot the live image, and for every wish typed in the OS let
# Claude Code build it on a wish/<slug> branch, then reboot the new image.
# test-wish-loop: the loop mechanics end to end with a stub 'claude' (no
# model calls, headless, a few minutes). wish-dry-run: show the exact
# claude command line build-wish.sh would run.
wish-loop:
	tools/claude/wish-loop.sh

test-wish-loop:
	tools/claude/test-wish-loop.sh

wish-dry-run:
	DRY_RUN=1 tools/claude/build-wish.sh "$(or $(WISH),a hello command that greets the forest)"

# --- UEFI boot path ---------------------------------------------------
# BOOTX64.EFI is a hand-written PE32+ (agentos-uefi.S) - no compiler.
# uefi.img = MBR with one type-EF partition holding a FAT12 ESP.
BOOTX64.EFI: agentos-uefi.S
	as agentos-uefi.S -o agentos-uefi.o
	ld -Ttext 0 -e 0 agentos-uefi.o -o agentos-uefi.elf
	objcopy -O binary -j .text agentos-uefi.elf BOOTX64.EFI

kernel32.bin: agentos32.img
	dd if=agentos32.img of=kernel32.bin bs=512 count=256 status=none   # flat kernel, 128 KB

esp.img: BOOTX64.EFI kernel32.bin
	dd if=/dev/zero of=esp.img bs=1024 count=1440 status=none
	mkfs.vfat -F 12 esp.img >/dev/null
	mmd -i esp.img ::/EFI ::/EFI/BOOT
	mcopy -i esp.img BOOTX64.EFI ::/EFI/BOOT/BOOTX64.EFI
	mcopy -i esp.img kernel32.bin ::/kernel32.bin

uefi.img: esp.img
	dd if=/dev/zero of=uefi.img bs=512 count=4928 status=none
	printf 'label: dos\nstart=2048, size=2880, type=ef\n' | sfdisk -q uefi.img
	dd if=esp.img of=uefi.img bs=512 seek=2048 conv=notrunc status=none
	@printf 'AGENTOS-MEDIUM' | dd of=uefi.img bs=512 seek=256 conv=notrunc status=none   # medium marker (diskon guard)

uefi: uefi.img

# hybrid.img: ONE image for both worlds. Sector 0 carries stage 1 AND the
# partition table (both live in agentos32.S); the raw kernel sits at LBA 1+
# for the BIOS path; the ESP at LBA 2048 holds stub + kernel32.bin for the
# UEFI path. The medium marker (256) and the slots (257-273) ride along in
# the gap - one stick for both firmware types.
hybrid.img: agentos32.img esp.img user.bin
	dd if=/dev/zero of=hybrid.img bs=512 count=4928 status=none
	dd if=agentos32.img of=hybrid.img bs=512 count=256 conv=notrunc status=none
	@printf 'AGENTOS-MEDIUM' | dd of=hybrid.img bs=512 seek=256 conv=notrunc status=none
	dd if=user.bin of=hybrid.img bs=512 seek=300 conv=notrunc status=none   # blob on disk: BIOS path 'run' reads LBA 300
	dd if=esp.img of=hybrid.img bs=512 seek=2048 conv=notrunc status=none

hybrid: hybrid.img

# pxe.img: network-bootable image = a no-disk Stage 1 + the flat kernel.
# A PXE NIC ROM downloads it to 0x7C00 and jumps; the stub falls straight
# through to Stage 2. Serve it via TFTP (tools/lan/pxe-server.sh) or QEMU (run-pxe).
pxe_stage1.bin: pxe_stage1.S
	as pxe_stage1.S -o pxe_stage1.o
	ld -Ttext 0x7c00 -e _start pxe_stage1.o -o pxe_stage1.elf
	objcopy -O binary -j .text pxe_stage1.elf pxe_stage1.bin

pxe.img: pxe_stage1.bin agentos32.img user.bin video.mjpg
	dd if=agentos32.img of=pxe.img bs=512 count=256 status=none   # 128 KB: stub + kernel
	dd if=pxe_stage1.bin of=pxe.img bs=512 count=1 conv=notrunc status=none
	# The no-disk path carries the C program AND the video clip in the
	# image. PXE loads the whole file to 0x7C00, so file sector N lands at
	# RAM 0x7C00 + N*512. The 256-sector kernel ends at RAM 0x27E00 and
	# UEFI_INFO sits at 0x28000, so the blob header is placed at sector
	# 259 (RAM 0x28200, clear of both). Program region = USER_BLOB_SECTORS
	# = 384 sectors (260..643); the M-JPEG clip follows at sector 644.
	# pxe_stage rescues both early in pm_go; the clip becomes a read-only
	# RAM disk.
	@python3 -c "import os,struct; pn=os.path.getsize('user.bin'); cs=((os.path.getsize('video.mjpg')+511)//512) if os.path.getsize('video.mjpg') else 0; f=open('pxe.img','r+b'); f.seek(259*512); f.write(b'AGUP'+struct.pack('<II',pn,cs)); f.close()"
	dd if=user.bin   of=pxe.img bs=512 seek=260 conv=notrunc status=none   # program @ sector 260 (RAM 0x28400)
	dd if=video.mjpg of=pxe.img bs=512 seek=644 conv=notrunc status=none   # clip    @ sector 644 (RAM 0x58400)
	truncate -s $$((832*512)) pxe.img   # pad past the clip (QEMU/iPXE PXE drops the file's last sectors)

pxe: pxe.img

# Boot pxe.img over QEMU's built-in TFTP/PXE - the headless proof that
# network boot works end to end (no disk attached).
run-pxe: pxe.img
	mkdir -p $(TFTP_DIR) && cp pxe.img $(TFTP_DIR)/pxe.img
	qemu-system-i386 -boot n \
	  -netdev user,id=n0,tftp=$(TFTP_DIR),bootfile=pxe.img \
	  -device rtl8139,netdev=n0

test-pxe: pxe.img test-pxe.sh
	./test-pxe.sh

# the SAME image through both worlds: full BIOS suite + UEFI suite
test-hybrid: hybrid.img test.sh test-uefi.sh
	./test.sh hybrid.img
	./test-uefi.sh hybrid.img

# SMP smoke: QEMU -smp 4, explicit smpon, AP scheduler counters.
test-smp: agentos32.img test-smp.sh
	./test-smp.sh

# --- writing USB sticks -----------------------------------------------
# All usb* targets overwrite the WHOLE device. Two guards before dd:
# $(DEV) must be a removable block device (lsblk RM=1), then a prompt.
# Usage: make usb32|usb-hybrid|usb-uefi DEV=/dev/sdX   (lsblk lists devices)
define USB_GUARD
	@test -n "$(DEV)" || (echo "Usage: make $@ DEV=/dev/sdX  (lsblk lists the devices)"; exit 1)
	@test -b "$(DEV)" || (echo "$(DEV) is not a block device"; exit 1)
	@test "$$(lsblk -dno RM $(DEV) 2>/dev/null | tr -d ' ')" = "1" || \
	  (echo "REFUSING: $(DEV) is not a removable device (lsblk RM=1). Pick the USB stick."; exit 1)
	@echo "WARNING: $(DEV) will be completely overwritten! Ctrl+C to abort, Enter to continue." && read dummy
endef

# Boots BIOS *and* UEFI.
usb-hybrid: hybrid.img
	$(USB_GUARD)
	sudo dd if=hybrid.img of=$(DEV) bs=512 status=progress && sync

# run-uefi boots a LIVE image, like run32: fresh stub + kernel are
# copied into the ESP on every start (mtools @@offset = partition
# start at 1 MB), but the MBR gap (marker + slots) survives rebuilds -
# the wish loop works on the UEFI path too.
run-uefi: uefi.img
	@test -n "$(OVMF)" || (echo "No OVMF firmware found - install ovmf or pass OVMF=/path/to/OVMF.fd"; exit 1)
	@test -f uefi-live.img || cp uefi.img uefi-live.img
	@mcopy -o -i uefi-live.img@@1048576 BOOTX64.EFI ::/EFI/BOOT/BOOTX64.EFI
	@mcopy -o -i uefi-live.img@@1048576 kernel32.bin ::/kernel32.bin
	@printf 'AGENTOS-MEDIUM' | dd of=uefi-live.img bs=512 seek=256 conv=notrunc status=none
	qemu-system-x86_64 -bios $(OVMF) \
	  -drive format=raw,file=uefi-live.img -net none

# For UEFI-only machines.
usb-uefi: uefi.img
	$(USB_GUARD)
	sudo dd if=uefi.img of=$(DEV) bs=512 status=progress && sync

# 32-bit kernel, BIOS boot.
usb32: agentos32.img
	$(USB_GUARD)
	sudo dd if=agentos32.img of=$(DEV) bs=512 status=progress && sync

test-uefi: uefi.img test-uefi.sh
	./test-uefi.sh

test32: agentos32.img test.sh
	./test.sh agentos32.img

# --- test suites ------------------------------------------------------
# test-run: the C-userspace proof. Boots agentos32.img (the BIOS HDD path,
# where the blob rides at LBA 300), runs the C program over serial and
# checks its banner reached COM1, then confirms the shell survives the
# ring-3 program. Not in test-all (the hybrid/pxe images of the gate carry
# their own blob checks).
test-jpeg: test-jpeg.sh user/jpeg.c user/jpeg.h
	./test-jpeg.sh

test-run: agentos32.img test-run.sh
	./test-run.sh

# regression: a degenerate on-disk M-JPEG frame must not #DE the player.
test-video-fuzz: agentos32.img test-video-fuzz.sh
	./test-video-fuzz.sh

# test-snake: the ring-3 snake game. Serial-headless: launch 'run snake',
# steer, quit, shell lives.
test-snake: agentos32.img test-snake.sh
	./test-snake.sh

test-net: agentos32.img test-net.sh
	./test-net.sh

# test-fetch: the neofetch-style system card ('fetch', user/fetch.c): serial
# facts (SYSINFO/AGENTS/cpuid) + a screendump proving the teal colour escapes.
test-fetch: agentos32.img test-fetch.sh
	./test-fetch.sh

# test-forest: the live agent forest ('forest', user/forest.c): screendumps
# for sky/aurora/trees/glow, animation between dumps, q quits + desktop repaint.
test-forest: agentos32.img test-forest.sh
	./test-forest.sh

test-ahci: hybrid.img test-ahci.sh
	./test-ahci.sh hybrid.img

# test-llm: the live wish loop. Mock proxy on the host (no API key needed),
# the OS asks over its own ring-3 TCP stack, the answer prints.
test-llm: agentos32.img test-llm.sh llm-proxy.py
	./test-llm.sh

# test-offload: compute offload. The OS ships a data-parallel job
# (Mandelbrot count / sum) to the proxy's /compute endpoint over its own TCP
# stack and prints the result. /compute runs no LLM backend = deterministic.
test-offload: agentos32.img test-offload.sh llm-proxy.py
	./test-offload.sh

# test-sound: AC97 PCM out under QEMU (audio sunk to 'none'); asserts
# detection + DMA progress from the bus-master registers.
test-sound: agentos32.img test-sound.sh
	./test-sound.sh

# test-script: the agents language - save a script into an AgentFS slot,
# 'script <slot>' executes it: pipeline + sleep + echo in order.
test-script: agentos32.img test-script.sh
	./test-script.sh

# test-llmscript: the (mock) LLM writes a script INTO the OS (llmscript ->
# SYS_WRITE_SLOT, diskon-guarded) and 'script' runs it.
test-llmscript: agentos32.img test-llmscript.sh llm-proxy.py
	./test-llmscript.sh

# test-autopilot: the OS flies itself - ask the LLM, run the script, repeat;
# two full rounds in mock mode, then Ctrl+C over serial stops the loop.
test-autopilot: agentos32.img test-autopilot.sh llm-proxy.py
	./test-autopilot.sh

# test-hda: Intel HDA, driver in ring-3 C over the PCI/MMIO syscalls;
# asserts codec walk + LPIB stream progress headless.
test-hda: agentos32.img test-hda.sh
	./test-hda.sh

# test-askd: the LLM agent - spawn ask / task ask <slot>: claim, read the
# slot, ask the mock proxy, write the answer back, finish.
test-askd: agentos32.img test-askd.sh llm-proxy.py
	./test-askd.sh

# test-remote: remote EXEC over the L2 tap (l2tap.py + QEMU -netdev dgram).
# Injects an EXEC frame, reads the OUT/END reply. Needs the REMOTE_CTL
# image (agentos32-dev.img) - the default image ignores the request.
test-remote: agentos32-dev.img test-remote.sh l2tap.py
	./test-remote.sh

# test-netwish: acknowledged netwish - headless via the L2 tap. Serial
# triggers 'netwish', we inject the host's ACK and confirm the retry loop
# stops ("delivered") - the ack round-trip, no endless re-broadcast.
test-netwish: agentos32.img test-netwish.sh l2tap.py
	./test-netwish.sh

# test-discovery: 'llm' broadcasts AGENTOS-PROXY? and adopts the answering
# proxy's IP+MAC, so the LLM loop works on a real LAN (not just the slirp
# 10.0.2.2). Headless via the L2 tap.
test-discovery: agentos32.img test-discovery.sh l2tap.py
	./test-discovery.sh

# test-d4: RAM-backed AgentFS slots. On a diskless/foreign-disk box diskon
# arms RAM-backed slots instead of refusing, so llmscript/script/autopilot
# run with no TannX OS medium - and the foreign disk is never written. Wipes
# the marker, checks save/load round-trips in RAM and the on-disk sector
# stays zero.
test-d4: agentos32.img test-d4.sh
	./test-d4.sh

# test-gui: the Dark Glass compositor. `gui` launches a ring-3 program
# that owns the framebuffer; screendump verifies its navy gradient wallpaper
# is on screen and the shell still answers underneath.
test-gui: agentos32.img test-gui.sh
	./test-gui.sh

# test-abort: "AGENTOS-ABORT" on :4713 breaks a wedged wait/chain/autopilot
# out WITHOUT a reboot. Headless via the L2 tap: wedge with gui;wait, inject
# the abort, confirm the shell is back. Needs the REMOTE_CTL image.
test-abort: agentos32-dev.img test-abort.sh l2tap.py
	./test-abort.sh

# test-wait: 'wait' self-heals, killing a program that goes ~30 s with no
# sys_progress heartbeat (stuck) and dropping the chain, so the autopilot
# recovers with no human/reboot. (~40 s: it waits out the budget.)
test-wait: agentos32.img test-wait.sh
	./test-wait.sh

# autopilot persistence (host-side, no QEMU - drives the proxy).
test-persist: test-persist.sh llm-proxy.py
	./test-persist.sh

# autopilot stall breaker (host-side, --mock, no QEMU).
test-stall: test-stall.sh llm-proxy.py
	./test-stall.sh

# autopilot mission telemetry (serial console).
test-mission: agentos32.img test-mission.sh
	./test-mission.sh

# virtio-gpu probe (ring-3 C, QEMU -device virtio-gpu-pci).
test-vgpu: agentos32.img test-vgpu.sh
	./test-vgpu.sh

# NVMe block driver (ring-3 C, QEMU -device nvme).
test-nvme: agentos32.img test-nvme.sh
	./test-nvme.sh

# virtio-net NIC (kernel, legacy I/O virtqueues) - the VM/cloud NIC.
test-virtio-net: agentos32.img test-virtio-net.sh
	./test-virtio-net.sh

# virtio-blk disk (ring-3, modern virtio MMIO) - the VM/cloud disk.
test-virtio-blk: agentos32.img test-virtio-blk.sh
	./test-virtio-blk.sh

# Robustness: the shared FAT layer survives a malformed disk
# (sectors/cluster=0 -> no divide-by-zero) with a valid-image positive control.
test-fatfs: agentos32.img test-fatfs.sh
	./test-fatfs.sh

# the `httpd` HTTP server - passive TCP open + curl.
test-httpd: agentos32.img test-httpd.sh
	./test-httpd.sh

# USB: `usb` xHCI driver - enumerate a usb-storage device.
test-usb: agentos32.img test-usb.sh
	./test-usb.sh

# USB: `usb backup`/`usb restore` - local slot persistence.
test-usb-persist: agentos32.img test-usb-persist.sh
	./test-usb-persist.sh

# USB: `usb ls`/`usb cat` - read a FAT16/FAT32 stick.
test-usb-fat: agentos32.img test-usb-fat.sh
	./test-usb-fat.sh

# USB: `usb load <file> <slot>` - run a script off a FAT stick.
test-usb-load: agentos32.img test-usb-load.sh
	./test-usb-load.sh

# test-chat: 'run chat' - the full-screen LLM chat against the mock proxy:
# typed prompt -> OS TCP stack -> answer bubble; screendump + serial markers.
test-chat: agentos32.img test-chat.sh llm-proxy.py
	./test-chat.sh

# test-edit: 'run edit <file>' - type, navigate (serial ESC-[ keys), Ctrl+S
# onto a virtio-blk FAT16 volume, read back on the host with mtools; plus the
# AgentFS slot fallback ('edit slot5' -> 'script 5').
test-edit: agentos32.img test-edit.sh
	./test-edit.sh

# test-sysmon: 'run sysmon' - live monitor: telemetry line, screendump of the
# dashboard while agents work, q quits.
test-sysmon: agentos32.img test-sysmon.sh
	./test-sysmon.sh


# sound: HDA capture + recorder (WAV round-trip via virtio-blk FAT), the
# synthesizer + HDA beep + CHIME=1 boot chime, and the voice wish (/stt mock).
test-rec: agentos32.img test-rec.sh
	./test-rec.sh

test-synth: agentos32.img test-synth.sh
	./test-synth.sh

test-voice: agentos32.img test-voice.sh llm-proxy.py
	./test-voice.sh

# The LLM suites take the proxy's host port from LLM_PROXY_PORT (proxy-port.sh,
# default 4080). Under test-all every suite picks a free random port, so two
# gates on one box - or a stray proxy left on :4080 - can never collide.
test-all: export LLM_PROXY_PORT ?= auto

# --- the TannX apps (user/tour.c www.c files.c shot.c cast.c rain.c) ---
# test-tour: the guided tour drives real shell commands (SYS_SHELL) and reads
# them back (SYS_CONSOLE); screendump of a step card.
test-tour: agentos32.img test-tour.sh
	./test-tour.sh

# test-www: text browser via the mock proxy's /fetch (+ the SSRF guard, host side).
test-www: agentos32.img test-www.sh llm-proxy.py proxy_ext.py
	./test-www.sh

# test-files: FAT file manager on a virtio-blk disk, delete verified with mtools.
test-files: agentos32.img test-files.sh
	./test-files.sh

# test-shot: screenshot -> BMP on the FAT volume (decoded on the host) and,
# without a disk, streamed to the proxy (POST /shot).
test-shot: agentos32.img test-shot.sh llm-proxy.py proxy_ext.py
	./test-shot.sh

# test-cast: Chromecast app + one-shot against the mock proxy's /cast/*.
test-cast: agentos32.img test-cast.sh llm-proxy.py proxy_ext.py
	./test-cast.sh

# test-rain: the agent rain screensaver animates (two screendumps differ).
test-rain: agentos32.img test-rain.sh
	./test-rain.sh

test-all: test-hybrid test-smp test-net test-pxe test-ahci test-snake test-llm test-offload test-sound test-script test-llmscript test-autopilot test-hda test-askd test-remote test-netwish test-discovery test-d4 test-gui test-abort test-wait test-persist test-stall test-mission test-vgpu test-nvme test-virtio-net test-virtio-blk test-fatfs test-video-fuzz test-httpd test-usb test-usb-persist test-usb-fat test-usb-load test-fetch test-forest test-chat test-edit test-sysmon test-rec test-synth test-voice test-tour test-www test-files test-shot test-cast test-rain

# test-hw: hardware-in-the-loop - drives the bare-metal test PC over UDP,
# exercising the RTL8168 path QEMU can't emulate. NOT in test-all: needs the
# test PC powered + PXE-booting on the LAN and a REMOTE_CTL image.
test-hw:
	tools/lan/test-hw.sh

debug32: agentos32.img
	qemu-system-i386 -drive format=raw,file=agentos32.img -nographic -s -S

# clean removes every generated file. The *-live.img images (run32/run-uefi
# scratch disks with your saved slots) are deliberately kept: make distclean.
clean:
	rm -f logo.cfg agentos32.o agentos32.elf agentos32.img \
	      agentos32-dev.o agentos32-dev.elf agentos32-dev.img \
	      agentos32-min.o agentos32-min.elf agentos32-min.img \
	      agentos-uefi.o agentos-uefi.elf BOOTX64.EFI esp.img uefi.img kernel32.bin hybrid.img \
	      pxe_stage1.o pxe_stage1.elf pxe_stage1.bin pxe.img \
	      user.bin net.bin user/*.o user/*.elf video.raw video.mjpg

distclean: clean
	rm -f agentos32-live.img uefi-live.img

.PHONY: FORCE all dev run run32 live32 wishes wish-loop test-wish-loop wish-dry-run uefi run-uefi hybrid pxe run-pxe minimal debug32 clean distclean \
        usb32 usb-uefi usb-hybrid \
        test32 test-run test-jpeg test-snake test-fetch test-forest test-video-fuzz test-all test-hw test-hybrid test-uefi test-pxe \
        test-smp test-net test-ahci test-llm test-offload test-sound test-script test-llmscript \
        test-autopilot test-hda test-askd test-remote test-netwish test-discovery test-d4 test-gui \
        test-abort test-wait test-persist test-stall test-mission test-vgpu test-nvme test-virtio-net \
        test-virtio-blk test-fatfs test-httpd test-usb test-usb-persist test-usb-fat test-usb-load \
        test-chat test-edit test-sysmon test-rec test-synth test-voice \
        test-tour test-www test-files test-shot test-cast test-rain
